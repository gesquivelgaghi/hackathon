# Env used by `vite ... --mode audit`, which is how the Lighthouse a11y check
# builds the app (see scripts/lighthouserc.cjs). MSW is enabled so every API
# call resolves with mock data; VITE_AUDIT_MODE flips the auth/feature guards
# into a "render whatever was requested" mode so Lighthouse can actually audit
# the dashboard pages instead of being bounced to /login.
VITE_APP_TITLE=Landscape
VITE_API_URL=/api/v2/
VITE_API_URL_OLD=/api/
VITE_API_URL_DEB_ARCHIVE=/debarchive/v1beta1/
VITE_ROOT_PATH=/
VITE_SELF_HOSTED_ENV=true
VITE_MSW_ENABLED=true
VITE_AUDIT_MODE=true
VITE_REPORT_VIEW_ENABLED=false
VITE_DETAILED_UPGRADES_VIEW_ENABLED=false
